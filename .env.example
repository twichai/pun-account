# ==========================================
# Pun Account (ปั้น) - Client Environment Config
# ==========================================

# Application Environment (development, staging, production)
APP_ENV=development

# Backend API Base URL
# - Desktop (macOS/Windows/Linux) & Web: http://localhost:8080/api/v1
# - Android Emulator: http://10.0.2.2:8080/api/v1
# - Real Device (LAN): http://<YOUR_LOCAL_IP>:8080/api/v1
API_BASE_URL=http://localhost:8080/api/v1

# API Network Request Timeout (in milliseconds)
API_TIMEOUT_MS=10000

# Google OAuth 2.0 Client IDs
# Obtained from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
